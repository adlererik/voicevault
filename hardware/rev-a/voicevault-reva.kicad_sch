      (instances (project "voicevault-reva" (path "/dd515cef-0748-530b-80bf-1859f81cb077" (reference "SW1") (unit 1)))))(text "VoiceVault Rev A | DK2 cabled carrier | electrical review draft" (at 25 15 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "52ff9488-22b5-5123-beec-129b3d19fc65"))(text "Reference STM32U5G9ZJT6Q revision Z. Verify actual DBGMCU ID before bench qualification." (at 25 22 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "fdf8ff74-878c-5d84-9c39-6aae237c99cf"))(text "Ports are harness connectors. Follow pin map and module wiring guide. Passive port ERC checks connectivity only." (at 25 28 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "48da70ea-79e6-5a07-8ccc-8797cb781f57"))(text "PCB placement is unrouted. Manufacturing release requires electrical, routing, thermal and bench review." (at 25 35 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "773681d9-6abe-5847-bb7d-a653c2302d8c"))(text "Radio is untrusted. Only 3.3V UART and credit signals cross the boundary. No audio, reset, SWD or update line." (at 25 260 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "5037cfda-34d6-55dc-953f-5229b085feb6"))(text "SW1 common pins 2 and 5. MIC OFF connects 2 to 3, grounds codec input, disconnects headset mic and releases sense." (at 25 267 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "df1cf767-1836-59e2-b33a-fb3da8671454"))(text "BQ24074 powered from Qi. Battery plugs into charger directly. Select 500mA input limit and 500mA charging." (at 25 274 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "a0c814b7-64b2-5508-9013-49e40b629583"))(text "5V regulator output feeds DK2 CN5.5 only after correct DK2 power selection. Never parallel bench power supplies." (at 25 281 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "44b550a1-0ade-51fb-89b0-959ccaf8e1bb"))
