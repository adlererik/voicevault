              (instances (project "voicevault-standalone-b0" (path "/244f3d5f-6baf-5cff-92f7-2b07700e6119/7015bb70-98e5-5264-961e-d6d2ce18cc18" (reference "R603") (unit 1)))))(text "TI SLOS602E pins/package; SLAA492A internal DLDO/ALDO sequence with DVDD-to-AVDD Schottky diode." (at 20 246 0) (effects (font (size 1 1)) (justify left)) (uuid "d53febe2-6afa-500a-8271-f483e10a2fcd"))(text "IOVDD uses VDD_3V3; LDOIN has a separate switched 500mA-capable regulator. LDO_SELECT high enables internal 1.72V DLDO; AVDD/DVDD are not tied to 3.3V." (at 20 252 0) (effects (font (size 1 1)) (justify left)) (uuid "082540ab-74ab-5303-aea5-28e784bcd58d"))(text "Hold RESET low while rails settle; wait at least 1ms after reset before writes, enable ALDO at >=DLDO voltage, then ADC/DAC." (at 20 258 0) (effects (font (size 1 1)) (justify left)) (uuid "6db198d3-37b1-5cb7-85bb-000e32e04552"))(text "SAI1 AF13: PE2 MCLK_A, PE3 SD_B capture, PE4 FS_A, PE5 SCK_A, PE6 SD_A playback." (at 20 264 0) (effects (font (size 1 1)) (justify left)) (uuid "3b8bbbd5-fa7b-55d9-ac77-20687736ff0b"))(text "Audio I2C2 PF0/PF1 and SAI are connected only to the trusted MCU; no radio wires." (at 20 270 0) (effects (font (size 1 1)) (justify left)) (uuid "cb74b3f8-0d9e-5a54-a316-f78405a63173"))
