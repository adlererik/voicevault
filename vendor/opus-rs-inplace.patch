+        // below before a reference is formed; no reference to the aggregate is
+        // made until all fields are valid. Source field coverage is checked by
+        // scripts/check_vendor.py, and constructor equivalence is exercised.
+        unsafe {
+            CeltEncoder::write_new_voip16k(&raw mut (*this).celt_enc);
+            (&raw mut (*this).silk_enc).write(SilkEncoderState::default());
+            (&raw mut (*this).silk_enc_side).write(SilkEncoderState::default());
+            (&raw mut (*this).application).write(Application::Voip);
+            (&raw mut (*this).sampling_rate).write(16000);
+            (&raw mut (*this).channels).write(1);
+            (&raw mut (*this).bandwidth).write(Bandwidth::Wideband);
+            (&raw mut (*this).bitrate_bps).write(64000);
+            (&raw mut (*this).complexity).write(9);
+            (&raw mut (*this).use_cbr).write(false);
+            (&raw mut (*this).use_inband_fec).write(false);
+            (&raw mut (*this).packet_loss_perc).write(0);
+            (&raw mut (*this).silk_initialized).write(false);
+            (&raw mut (*this).mode).write(OpusMode::SilkOnly);
+            (&raw mut (*this).prev_enc_mode).write(None);
+            (&raw mut (*this).forced_mode).write(None);
+            (&raw mut (*this).variable_hp_smth2_q15).write(silk_lin2log(60) << 8);
