+            FixedVec::write_from_value(&raw mut (*this).buf_silk_api_channel, 0, 0);
+            FixedVec::write_from_value(&raw mut (*this).buf_celt_input, 0.0, 0);
+            FixedVec::write_from_value(&raw mut (*this).delay_buffer, 0.0, OPUS_DELAY_BUF);
